    "cmake.configureOnOpen": false,
    "cmake.debugConfig": {
        "args": ["--debug"]
    },
    "json.schemas": [
        {
            "fileMatch": [
                "**/*flatpak.json",
                "**/*flatpak.json.in"
            ],
            "url": "https://raw.githubusercontent.com/flatpak/flatpak-builder/main/data/flatpak-manifest.schema.json"
        }
    ],
    "C_Cpp.files.exclude": {
        "**/app/src/core_module/third_party/**": true,
        "**/app/src/core_module/build/**": true,
        "**/app/src/core_module/install/**": true,
        "**/build/**": true,
        "**/install/**": true,
        "**/app/src/core_module/extensions/chrome/orion-api-test/corpus/**": true,
        "**/app/src/core_module/third_party/WebKit/JSTests": true,
        "**/app/src/core_module/third_party/WebKit/LayoutTests": true,
        "**/app/src/core_module/third_party/WebKit/ManualTests": true,
        "**/app/src/core_module/third_party/WebKit/PerformanceTests": true,
        "**/app/src/core_module/third_party/WebKit/WebDriverTests": true,
        "**/app/src/core_module/third_party/WebKit/WebKitBuild": true,
        "**/app/src/core_module/third_party/WebKit/Websites": true,
        "**/app/src/core_module/third_party/WebKit/Tools/WebKitTestRunner": true,
        "**/app/src/core_module/third_party/WebKit/Tools/TestWebKitAPI": true,
        "**/.vscode": true,
        "**/.vs": true,
        "**/run/user/*/doc/**": true //xdg document portal can cause intellisense to infinitely cycle if mapping specific folders
    },
    "files.watcherExclude": {
        "**/app/src/core_module/third_party/**": true,
        "**/app/src/core_module/build/**": true,
        "**/build/**": true,
        "**/install/**": true,
        "**/run/user/*/doc/**": true //xdg document portal can cause intellisense to infinitely cycle if mapping specific folders
    },
    "search.exclude": {
        "**/app/src/core_module/third_party/**": true,
        "**/build/**": true,
        "**/install/**": true
    },
    "C_Cpp.workspaceParsingPriority": "low",
    "C_Cpp.maxConcurrentThreads": 2,
    "C_Cpp.maxCachedProcesses": 2,
    "C_Cpp.maxMemory": 4096,
    "C_Cpp.intelliSense.maxMemory": 3072,
    "C_Cpp.intelliSenseMemoryLimit": 2048,
    "C_Cpp.intelliSenseCacheSize": 1024,
    "C_Cpp.codeAnalysis.runAutomatically": false,
    "debug.toolBarLocation": "commandCenter",
    "files.associations": {
        "atomic": "cpp",
        "array": "cpp",
        "charconv": "cpp",
        "compare": "cpp",
        "functional": "cpp",
        "ratio": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "variant": "cpp",
        "string": "cpp",
        "string_view": "cpp",
        "span": "cpp",
        "chrono": "cpp",
        "format": "cpp",
        "cstdlib": "cpp",
        "*.inc": "cpp",
        "regex": "cpp",
        "system_error": "cpp",
        "new": "cpp",
        "any": "cpp",
        "bit": "cpp",
        "bitset": "cpp",
        "cctype": "cpp",
        "cfenv": "cpp",
        "cinttypes": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "codecvt": "cpp",
        "complex": "cpp",
        "concepts": "cpp",
        "condition_variable": "cpp",
        "coroutine": "cpp",
        "csetjmp": "cpp",
        "csignal": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "forward_list": "cpp",
        "list": "cpp",
        "map": "cpp",
        "set": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "fstream": "cpp",
        "future": "cpp",
        "initializer_list": "cpp",
        "iomanip": "cpp",
        "iosfwd": "cpp",
        "iostream": "cpp",
        "istream": "cpp",
        "limits": "cpp",
