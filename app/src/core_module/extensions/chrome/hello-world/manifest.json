{
  "manifest_version": 2,
  "name": "Hello World",
  "version": "1.0.0",
  "description": "A minimal extension with a background script and popup.",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "64": "icon.png"
    },
    "default_title": "Hello World",
    "default_popup": "popup.html"
  }
}
