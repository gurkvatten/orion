{
  "manifest_version": 3,
  "name": "Orion API Test",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome: Run API Tests"
  },
  "background": {
    "service_worker": "background.sw.js"
  },
  "permissions": [
    "debug",
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ]
}
