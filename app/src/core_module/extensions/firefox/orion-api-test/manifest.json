{
  "manifest_version": 2,
  "name": "Orion API Test",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Firefox: Run API Tests"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "permissions": [
    "debug",
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "orion-api-test@orion.test"
    }
  }
}
