using Gtk 4.0;
using Adw 1;

template $LowPowerModeDialog: Adw.Dialog {
  content-width: 400;
  content-height: 250;
  title: _("Low Power Mode");
  //TODO nastav jmeno

  Adw.ToolbarView {
    //[top]
   // Adw.HeaderBar {}

   Box {
      orientation: vertical;
      Box {
        margin-top: 20;
        halign: center;
        Image {
          name: "orion-logo";
          icon-name: "orion-logo";
          pixel-size: 49;
          margin-start: 40;
          margin-end: 40;
        }
      }

      Box {          
        margin-top: 20;
        margin-start: 20;
        margin-end: 20;
        halign: center;
        Label {
         styles [
          "bold-text"
          ]
          label: _("Turn on “Low Power Mode”?");
        }
      }
      
      Box {
        margin-top: 15;
        margin-start: 20;
        margin-end: 20;
        halign: center;
        Label {     
          wrap: true;
          max-width-chars: 60;
          width-chars:15;
          justify: center;
          label: _("Reduces power usage by instantly hibernating all tabs after 5 minutes, except for the current tab and pinned tabs.");         
          }
        }  
        Box {
          orientation: horizontal;
          margin-top: 20;
          margin-bottom: 20;
          margin-end: 20;
          margin-start: 20;
          spacing: 10;
          Box {
            homogeneous: true;
            Button cancel_button {
              label: _("Cancel");
              hexpand: true; 
              halign: fill; 
              valign: center;
              clicked => $on_close_button_clicked();
            }
          }
          Box {
            homogeneous: true;
            Button enable_button{
              label: _("Enable");
              styles ["suggested-action"]
              hexpand: true; 
              halign: fill; 
              valign: center;
              clicked => $on_enable_button_clicked();
            }
          }
        }
      }
    }
  }

SizeGroup {
  mode: horizontal;
  widgets [enable_button, cancel_button]
}
