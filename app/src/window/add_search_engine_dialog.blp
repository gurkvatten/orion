using Gtk 4.0;
using Adw 1;

template $AddSearchEngineDialog: Adw.Dialog {
  content-width: 550;
  content-height: 250;
  title: _("AddSearchEngineDialog");

  Adw.ToolbarView {
    Grid {
      margin-start:10;
      margin-end:10;
      margin-top:10;
      margin-bottom:10;
      column-spacing:10;
      row-spacing:5;
      hexpand:true;
      halign:fill;

      Box {
        margin-bottom:5;
        layout {
        row:0;
          column:0;
        }
        Label {
          styles [
            "bold-text"
          ]
          label: _("Add Search Engine");
        }  
      }

      Box {
        layout {
          row:1;
          column:0;
        }
        Label {
          label: _("Name:");
        }    
      }

      Box {
        layout {
          row:1;
          column:1;
        }
        Entry name_entry {
          placeholder-text: _("");
          hexpand: true;
          halign: fill;
        }
      }

      Box {
        layout {
          row:2;
          column:0;
        }
        Label {
          label: _("Search URL template:");
        }    
      }

      Box {
        layout {
          row:2;
          column:1;
        }
        Entry search_url_template_entry {
          placeholder-text: _("%s in place of query");
          hexpand: true;
          halign: fill;
        }
      }

      Box {
        layout {
        row:3;
        column:0;
        }
        Label {
          label: _("Suggestions URL template");
        }    
      }

      Box {
        layout {
          row:3;
          column:1;
        }
        Entry suggestions_url_template_entry {
          placeholder-text: _("%s in place of search term");
          hexpand: true;
          halign: fill;
        }
      }

      Box {
        layout {
          row:4;
          column:0;
        }
        Label {
          label: _("Keyword");
        }    
      }

      Box {
        layout {
          row:4;
          column:1;
        }
        Entry keyword_entry {
          placeholder-text: _("Invocation character or keyword");
          hexpand: true;
          halign: fill;
        }
      }

      Box {
        orientation: horizontal;
        halign: end;
        hexpand: true;
        margin-top: 20;
        spacing:10;
        layout {
          row:5;
          column:1;
        }

        Button cancel_button {
          label: _("Cancel");
          clicked => $on_close_button_clicked();
        }
        Button save_engine_button {
          label: _("Save Engine");
          styles ["suggested-action"]
          clicked => $on_save_engine_button_clicked();
        }
      }
    }
  }
}

SizeGroup {
  mode: horizontal;
  widgets [cancel_button, save_engine_button]
}