// #pragma include "settings.blp"
using Gtk 4.0;
using Adw 1;
using Gio 2.0;

//NOTE: we produce error messages when we are not provided enough height:
//"Trying to measure GtkGrid 0x5555621a0800 for height of 682, but it needs at least 753"
//this warning is emitted on width measure of the grids, it's seeminlgy just a harmless warning
//it involves the ScrolledWindow widgets and labels with wrap:true,
//perhaps the minimum height of a grid changes between it first being measured
//and that measurement subsequently being used as the for_size later on

template $SettingsDialog: Adw.Dialog {
  //width-request:500;
  height-request:-1;
  title: _("Settings");
  name: "settings-dialog";
  hexpand:true;
  halign:fill;

  Adw.ToolbarView {
    top-bar-style: raised;

    [top]
    Adw.HeaderBar {
      
    }
    [top]
    ScrolledWindow {
      propagate-natural-width: true;
      hexpand:true;
      halign:fill;
      valign:center;
      StackSwitcher {
        margin-start:5;
        margin-end:5;
        halign:center;
        valign:center;
        styles [
          "flat-compact-switcher"
        ]
        stack: stack;
      }
    }
    //setting labels named settingLabel$$# where $$ are the first 2 letters of category name, # is numeric index
    
    //width of left column in grid comes from the first row
    hexpand:true;
    halign:fill;

    content:Stack stack{
      hexpand:true;
      halign:fill;
      
      //switch-page => $on_notebook_switch_page();
      //we bind to the pages selection model from settings_dialog.cpp instead
      StackPage {
        name: "general_tab";
        title: _("General");
        child: ScrolledWindow {
          propagate-natural-width: true;
          propagate-natural-height: true;
          Grid { //General tab
            halign:center;
            Grid {
              layout {
                row:0;
                column:0;
              }
              margin-top:20;
              margin-bottom: 20;
              row-spacing:5;


              Box settingLabelGE1{
                layout {
                  row:0;
                  column:0;
                }
                halign: end;
                Label {
                  margin-end:15;
                  label:_("Orion opens with:");
                }
              }
              Box box1{
                layout {
                  row:0;
                  column:1;
                }
                hexpand:true;
                DropDown orionOpensDropDown{
                  hexpand:true;
                  model: StringList { //general_settings.cpp relies on the exact order of this
                    strings [
                      _("A new window"),
                      _("A new private window"),
                      _("All windows from last session"),
                      _("All non-private windows from last session"),
                    ]
                  };
                  map => $on_orion_opens_drop_down_map();
                  notify::selected => $on_orion_opens_drop_down_notify_selected();
                }
              }


              Box settingLabelGE2{
                layout {
                  row:1;
                  column:0;
                }
                halign: end;
                Label {
                  margin-end:15;
                  label:_("New windows open with:");
                }
              }
              Box box2{
                layout {
                  row:1;
                  column:1;
                }
                margin-end:140;
                hexpand:true;
                DropDown windowOpensDropDown{
                  hexpand:true;
                  model: StringList {
                    strings [
                      _("Start Page"),
                      _("Empty Page"),
                      _("Same Page"),
                      _("Homepage"),
                      _("Notes"),
                    ]
                  };
                  map => $on_window_opens_drop_down_map();
                  notify::selected => $on_window_opens_drop_down_notify_selected();
                }
              }


              Box settingLabelGE3{
                layout {
                  row:2;
                  column:0;
                }
                halign: end;
                Label {
                  margin-end:15;
                  label:_("New tabs open with:");
                }
              }
              Box box3{
                layout {
                  row:2;
                  column:1;
                }
                hexpand:true;
                DropDown tabOpensDropDown{
                  hexpand:true;
                  model: StringList {
                    strings [
                      _("Start Page"),
                      _("Empty Page"),
                      _("Same Page"),
                      _("Homepage"),
                      _("Notes"),
                    ]
                  };
                  map => $on_tab_opens_drop_down_map();
                  notify::selected => $on_tab_opens_drop_down_notify_selected();
                }
              }



              Box settingLabelGE4{
                layout {
                  row:3;
                  column:0;
                }
                halign: end;
                Label {
                  margin-end:15;
                  label:_("Homepage:");
                }
              }
              Box box4{
                layout {
                  row:3;
                  column:1;
                }
                hexpand:true;
                Entry homepageEntry{
                  hexpand:true; 
                  activates-default:false;
                  text: "https://kagi.com/";
                  map => $on_homepage_entry_map();
                  notify::text => $on_homepage_entry_notify_text();
                }
              }
              Box box5{
                layout {
                  row:4;
                  column:1;
                }
                Button setHomepageToCurrentButton {
                  halign:start;
                  label:_("Set to Current Page");
                }
              }


              Box settingLabelGE5{
                layout {
                  row:5;
                  column:0;
                }
                halign: end;
                Label {
                  margin-end:15;
                  label:_("File download location:");
                }
              }
              Box box6{
                layout {
                  row:5;
                  column:1;
                }
                hexpand:true;
                Grid {
                  row-spacing:4;
                  DropDown fileDownloadLocationDropDown {
                    hexpand:true;
                    model: StringList{
                      strings [
                        _("Downloads"), // TODO: should be dynamic
                        // separators in GtkDropDown are probably not supported
                        _("Ask for each download"),
                        _("Other…"), // TODO: wire folder chooser system dialog here
                      ]
                    };
                    notify::selected => $on_file_download_location_drop_down_notify_selected();
                    map => $on_file_download_location_drop_down_map();
                  }
                }
              }


              Box settingLabelGE6{
                layout {
                  row:6;
                  column:0;
                }
                halign: end;
                Label {
                  margin-end:15;
                  label:_("Remove download items:");
                }
              }
              Box box7{
                layout {
                  row:6;
                  column:1;
                }
                halign:start;
                DropDown removeDownloadsDropDown {
                  styles [
                    "dropdown-section-separators",
                  ]
                  hexpand:true;
                  header-factory: BuilderListItemFactory {
                    template ListHeader {
                      child: Separator {
                        visible: bind ($remove_downloads_drop_down_get_separator_visible(template.start)) as <bool>;
                      };
                    }
                  };
                  model: FlattenListModel {
                    model: Gio.ListStore {
                      StringList {
                        strings [
                          _("After one day"),
                          // separator
                        ]
                      }
                      StringList {
                        strings [
                          _("After Orion exits"),
                          _("Upon successful download"),
                          _("Manually"),
                        ]
                      }
                    };
                  };
                  map => $on_remove_downloads_drop_down_map();
                  notify::selected => $on_remove_downloads_drop_down_notify_selected();
                }
              }
              Box box8{
                layout {
                  row:7;
                  column:1;
                }
                hexpand:true;
                orientation: vertical;
                spacing: 4;
                CheckButton openSafeAfterDownloadButton {
                  sensitive: false; // TODO: implement this
                  hexpand:true;
                  halign:start;
                  label:_("Open “safe” files after downloading");
                  map => $on_open_safe_after_download_check_button_map();
                  toggled => $on_open_safe_after_download_check_button_toggled();
                }
                Label {
                  xalign:0;
                  halign:fill;
                  hexpand:true;
                  margin-start:24;
                  wrap:true;
                  max-width-chars: 65;
                  label:_("“Safe” files include movies, pictures, sounds, PDF and text documents, and archives.");
                }
              }


              Box settingLabelGE7{
                layout {
                  row:8;
                  column:0;
                }
                halign: end;
                Label {
                  margin-end:15;
                  label:_("Language:");
                }
              }
              Box box9{
                layout {
                  row:8;
                  column:1;
                }
                hexpand:true;
                DropDown languageDropDown{
                  sensitive: false; // TODO: implement this
                  hexpand:true;
                  model: StringList {
                    strings [
                      _("Deutsch – German"),
                      _("العربية – Arabic"), // reverse flow
                      _("ελληνικά – Greek"),
                      _("简体中文 – Chinese, Simplified"),
                      _("日本語 – Japanese"),
                      _("English"),
                      _("українська – Ukrainian"),
                      _("español – Spanish"),
                      _("slvenščina – Slovenian"),
                      _("galego – Galician"),
                      _("italiano – Italian"),
                      _("svenska – Swedish"),
                      _("čeština – Czech"),
                      _("繁體中文 – Chinese, Traditional"),
                      _("Türkçe – Turkish"),
                      _("polski – Polish"),
                      _("português – Portuguese (Brazil)"),
                      _("pусский – Russian"),
                      _("français – French"),
                      _("suomi – Finnish"),
                      _("Nederlands – Dutch"),
                      _("polski (Polska) – Polish (Poland)"),
                    ]
                  };
                  map => $on_language_drop_down_map();
                  notify::selected => $on_language_drop_down_notify_selected();
                }
              }
              Box box10{
                layout {
                  row:9;
                  column:1;
                }
                hexpand:true;
                Label {
                  xalign:0;
                  halign:fill;
                  hexpand:true;
                  wrap:true;
                  use-markup:true;
                  label:_("Orion translations are done by the community, if you wish to contribute, <a href=\"https://kagi.com\">click here</a>"); //TODO: correct link
                }
              }


              Box settingLabelGE8{
                layout {
                  row:10;
                  column:0;
                }
                halign:end;
                Label {
                  margin-end:15;
                  label:_("Default profile:");
                }
              }
              Box box11{
                layout {
                  row:10;
                  column:1;
                }
                hexpand:true;
                DropDown defaultProfileDropDown { //TODO: missing color splash for profile, use ListStore with factory here
                  hexpand:true;
                  factory: BuilderListItemFactory {
                    template ListItem {
                      child: Label {
                        xalign:0;
                        label: bind ($default_profile_drop_down_listitem_get_label(template.item)) as <string>;
                        use-markup:true;
                      };
                    }
                  };
                  map => $on_default_profile_drop_down_map();
                  notify::selected => $on_default_profile_drop_down_notify_selected();
                }
                Button manageProfilesButton {
                  margin-start:15;
                  label:_("Manage Profiles…");
                  clicked => $on_manage_profiles_clicked();
                }
              }


              Box settingLabelGE9{
                layout {
                  row:11;
                  column:0;
                }
                halign:end;
                Label {
                  margin-end:15;
                  label:_("Open external links in:");
                }
              }
              Box box12{
                layout {
                  row:11;
                  column:1;
                }
                hexpand:true;
                DropDown openExternalLinksDropDown {
                  sensitive: false; // TODO: implement this
                  hexpand:true;
                  model: StringList {
                    strings [
                      _("Last active profile"),
                      _("Default profile"),
                    ]
                  };
                  
                  map => $on_open_external_links_drop_down_map();
                  notify::selected => $on_open_external_links_drop_down_notify_selected();
                }
              }


              Separator {
                layout {
                  row:12;
                  column:0;
                }
                margin-top:20;
                margin-bottom:25;
                margin-start:50;
                orientation:horizontal;
              }
              Separator {
                layout {
                  row:12;
                  column:1;
                }
                margin-top:20;
                margin-bottom:25;
                margin-end:50;
                orientation:horizontal;
              }


              Box settingLabelGE10{
                layout {
                  row:13;
                  column:0;
                }
                halign: end;
                Label {
                  margin-end:15;
                  label:_("Import browser data:");
                }
              }
              Box box13{
                layout {
                  row:13;
                  column:1;
                }
                margin-end:140;
                Button {
                  sensitive: false; // TODO: implement this
                  halign:start; 
                  label:_("Import…");
                  clicked => $on_import_browser_data_clicked();
                }
              }
              Box box14{
                layout {
                  row:14;
                  column:1;
                }
                margin-end:140;
                Label {
                  xalign:0;
                  halign:fill;
                  hexpand:true;
                  wrap:true;
                  label:_("Import your bookmarks, history, passwords and more from other browsers.");
                }
              }

              Box settingLabelGE11{
                layout {
                  row:15;
                  column:0;
                }
                halign: end;
                Label {
                  margin-end:15;
                  label:_("Orion updates:");
                }
              }
              Box box15{
                layout {
                  row:15;
                  column:1;
                }
                margin-end:140;
                Box box16{
                  CheckButton automaticallyKeepUpToDateButton{
                    sensitive: false; // TODO: implement this
                    label:_("Automatically keep Orion up to date");
                    map => $on_automatically_keep_up_to_date_check_button_map();
                    toggled => $on_automatically_keep_up_to_date_check_button_toggled();
                  }
                }
              }
              Box box17{
                layout {
                  row:16;
                  column:1;
                }
                margin-end:140;
                CheckButton showWarningBeforeQuitButton{
                  label:_("Show warning before quitting");
                    map => $on_show_warning_before_quit_check_button_map();
                    toggled => $on_show_warning_before_quit_check_button_toggled();
                }
              }

              
              Separator {
                visible: false;
                layout {
                  row:17;
                  column:0;
                }
                margin-top:20;
                margin-bottom:20;
                margin-start:50;
                orientation:horizontal;
              }
              Separator {
                visible: false;
                layout {
                  row:17;
                  column:1;
                }
                margin-top:20;
                margin-bottom:20;
                margin-end:50;
                orientation:horizontal;
              }
            }


            Box box19{
              visible: false;
              layout {
                row:1;
                column:0;
              }
              halign: center;
              margin-bottom:25;

              // From Flatpak app, the default browser app cannot be set. That is probably why Flatpak versions of
              // Firefox and Chromium does not show the option to set default browser in their settings.
              Label {
                label:_("Orion is not your default browser.");
              }
              Button set_default_browser_button {
                margin-start:20;
                label:_("Set Default");
              }
            }
          }
        };
      }

      // [tab]
      // Label generalTab{
      //   label: _("General");
      // } //End of General tab

      StackPage {
        name: "appearance_tab";
        title: _("Appearance");
        child: ScrolledWindow {
          propagate-natural-width: true;
          propagate-natural-height: true;
          Grid { //Appearance tab
            halign:center;
            Grid {
              layout {
                row:0;
                column:0;
              }
              margin-top:20;
              row-spacing:5;
              column-spacing:15;


              Box settingLabelAP1{
                layout {
                  row:0;
                  column:0;
                }
                Label {
                  halign: end;
                  label:_("Theme:");
                }
              }
              Box box20{
                layout {
                  row:0;
                  column:1;
                }
                DropDown themeDropDown {
                  model: StringList {
                    strings [
                      _("System"),
                      _("Light"),
                      _("Dark"),
                    ]
                  };
                  map => $on_theme_drop_down_map();
                  notify::selected => $on_theme_drop_down_notify_selected();
                }
                Button customize_theme_button {
                  margin-start:20;
                  label:_("Customize…");
                  clicked => $on_customize_theme_button_clicked();
                }
              }
              Box box21{
                layout {
                  row:1;
                  column:1;
                }
                margin-bottom:15;
                CheckButton showWebsiteColorCheckButton {
                  sensitive: false; // TODO: implement this
                  label:_("Show website color for compact & vertical tabs");
                  map => $on_show_website_color_check_button_map();
                  toggled => $on_show_website_color_check_button_toggled();
                }
              }


              Box settingLabelAP2{
                layout {
                  row:2;
                  column:0;
                }
                halign:end;
                Label {
                  label:_("Toolbar:");
                }
              }
              Box box22{
                layout {
                  row:2;
                  column:1;
                }
                CheckButton alwaysShowToolbarCheckButton {
                  label:_("Always show toolbar in full screen");
                  map => $on_always_show_toolbar_in_fs_check_button_map();
                  toggled => $on_always_show_toolbar_in_fs_check_button_toggled();
                }
              }
              Box box23{
                layout {
                  row:3;
                  column:1;
                }
                margin-bottom:15;
                Grid {
                  row-spacing:5;
                  CheckButton showBoomkarksCheckButton {
                    layout {
                      row:1;
                      column:0;
                    }
                    label:_("Show bookmarks bar");
                    map => $on_show_bookmarks_bar_check_button_map();
                    toggled => $on_show_bookmarks_bar_check_button_toggled();
                  }
                  CheckButton showProfileCheckButton {
                    sensitive: false; // obsolete
                    layout {
                      row:2;
                      column:0;
                    }
                    label:_("Show profile in address bar");
                    map => $on_show_profile_in_address_bar_check_button_map();
                    toggled => $on_show_profile_in_address_bar_check_button_toggled();
                  }
                  CheckButton displayRssIndicatorCheckButton {
                    sensitive: false; // TODO: implement this
                    layout {
                      row:3;
                      column:0;
                    }
                    label:_("Display RSS Feeds indicator");
                    map => $on_display_rss_feeds_indicator_check_button_map();
                    toggled => $on_display_rss_feeds_indicator_check_button_toggled();
                  }
                  CheckButton displayWebAppIndicatorCheckButton {
                    sensitive: false; // TODO: implement this
                    layout {
                      row:4;
                      column:0;
                    }
                    label:_("Display Web Application indicator");
                    map => $on_display_web_app_indicator_check_button_map();
                    toggled => $on_display_web_app_indicator_check_button_toggled();
                  }
                }
              }

              
              Box settingLabelAP3 {
                layout {
                  row:4;
                  column:0;
                }
                halign:end;
                margin-bottom:15;
                Label {
                  label:_("Bookmarks bar:");
                }
              }
              Box box24{
                layout {
                  row:4;
                  column:1;
                }
                margin-bottom:15;
                DropDown bookmarksBarDropDown {
                  model: StringList {
                    strings [
                      _("Text only"),
                      _("Icon and text"),
                      _("Icon only"),
                    ]
                  };
                  map => $on_bookmarks_bar_style_drop_down_map();
                  notify::selected => $on_bookmarks_bar_style_drop_down_notify_selected();
                }
              }


              Box settingLabelAP4 {
                layout {
                  row:5;
                  column:0;
                }
                halign: end;
                margin-bottom:15;
                Label {
                  label:_("Sidebar:");
                }
              }
              Box box25{
                layout {
                  row:5;
                  column:1;
                }
                margin-bottom:15;
                CheckButton autoShowSidebarCheckButton {
                  label:_("Auto-show sidebar in full screen");
                  map => $on_auto_show_sidebar_in_fs_check_button_map();
                  toggled => $on_auto_show_sidebar_in_fs_check_button_toggled();
                }
              }


              Box settingLabelAP5 {
                layout {
                  row:6;
                  column:0;
                }
                halign: end;
                margin-bottom:15;
                Label {
                  label:_("Default font:");
                }
              }
              Box box26{
                layout {
                  row:6;
                  column:1;
                }
                margin-bottom:15;
                DropDown defaultFontDropDown {
                  sensitive: false; // TODO: implement this
                  model: StringList {
                    strings [ // TODO: fill dynamically
                      _("Times New Roman"),
                    ]
                  };
                }
                Button customizeFontButton {
                  margin-start:20;
                  label:_("Customize…");
                  clicked => $on_customize_default_font_clicked();
                }
              }


              Box settingLabelAP6 {
                layout {
                  row:7;
                  column:0;
                }
                halign: end;
                Label {
                  label:_("Rendering:");
                }
              }
              Box box27{
                layout {
                  row:7;
                  column:1;
                }
                CheckButton preferFastRenderingUpdatesCheckButton {
                  sensitive: false; // TODO: implement this
                  label:_("Prefer page rendering updates near 120fps");
                  map => $on_prefer_fast_rendering_page_updates_check_button_map();
                  toggled => $on_prefer_fast_rendering_page_updates_check_button_toggled();
                }
              }
              Box box28{
                layout {
                  row:8;
                  column:1;
                }
                margin-bottom:15;
                CheckButton disableTransparencyCheckButton {
                  sensitive: false; // TODO: implement this
                  label:_("Disable transparency for full screen windows");
                  map => $on_disable_transparency_for_fs_windows_check_button_map();
                  toggled => $on_disable_transparency_for_fs_windows_check_button_toggled();
                }
              }


              Box settingLabelAP7 {
                layout {
                  row:9;
                  column:0;
                }
                halign: end;
                valign: center;
                Label {
                  label:_("App icon:");
                }
              }
              Box box29{
                layout {
                  row:9;
                  column:1;
                }
                homogeneous:true;
                spacing:20;
                hexpand:false;
                halign:start;
                ToggleButton app_icon_button_a { //TODO: get icons
                  styles [
                    "app-icon-button"
                  ]
                  active:true;
                  Image {
                    halign: center;
                    pixel-size:50;
                    icon-name: "orion-logo";
                  }
                  action-name: "win.app-icon-setting";
                  action-target: "'orion-logo-a'";
                  map => $on_app_icon_radio_buttons_map();
                }

                ToggleButton app_icon_button_b { //TODO: get icons
                  styles [
                    "app-icon-button"
                  ]
                  group:app_icon_button_a;
                  Image {
                    halign: center;
                    pixel-size:50;
                    icon-name: "orion-logo";
                  }
                  action-name: "win.app-icon-setting";
                  action-target: "'orion-logo-b'";
                }

                ToggleButton app_icon_button_c { //TODO: get icons
                  styles [
                    "app-icon-button"
                  ]
                  group:app_icon_button_a;
                  Image {
                    halign: center;
                    pixel-size:50;
                    icon-name: "orion-logo";
                  }
                  action-name: "win.app-icon-setting";
                  action-target: "'orion-logo-c'";
                }
              }
            }
          }
        };
      }

      // [tab]
      // Label appearanceTab{
      //   label:_("Appearance");
      // } //End of Appearance tab

      StackPage {
        name: "tabs_tab";
        title: _("Tabs");
        child: ScrolledWindow {
          propagate-natural-width: true;
          propagate-natural-height: true;
          Grid { //Tabs tab
            halign:center;
            Grid {
              layout {
                row:0;
                column:0;
              }
              margin-top:20;
              row-spacing:5;
              column-spacing:15;


              Box settingLabelTA1 {
                layout {
                  row:0;
                  column:0;
                }
                halign: end;
                valign: center;
                margin-bottom:15;
                Label {
                  label:_("Tab layout:");
                }
              }
              Box box30{
                layout {
                  row:0;
                  column:1;
                }
                margin-bottom:15;
                Box {
                  homogeneous:true;
                  spacing:20;
                  hexpand:false;
                  ToggleButton tab_layout_button_a { //TODO: get icons
                    active: true;
                    styles [
                      "tab-style-toggle-button",
                    ]
                    Box {
                      orientation: vertical;
                      halign: center;

                      Image {
                        halign: center;
                        pixel-size:64;
                        icon-name: "orion-logo";
                      }

                      Label {
                        halign: center;
                        label: _("Standard");
                      }
                    }
                    action-name: "win.tab-layout-setting";
                    action-target: "'standard'";
                  }

                  ToggleButton tab_layout_button_b { //TODO: get icons
                    styles [
                      "tab-style-toggle-button",
                    ]
                    group: tab_layout_button_a;
                    Box {
                      orientation: vertical;
                      halign: center;

                      Image {
                        halign: center;
                        pixel-size:64;
                        icon-name: "orion-logo";
                      }

                      Label {
