                        notify::selected => $on_websites_default_tracking_prevention_drop_down_notify_selected();
                      };
                    }

                    StackPage {
                      name: "cookies";
                      child: DropDown websitesDefaultCookiesDropDown {
                        halign:end;
                        model: StringList { strings [ _("On"), _("Off") ] };
                        map => $on_websites_default_cookies_drop_down_map();
                        notify::selected => $on_websites_default_cookies_drop_down_notify_selected();
                      };
                    }

                    StackPage {
                      name: "javascript";
                      child: DropDown websitesDefaultJavascriptDropDown {
                        halign:end;
                        model: StringList { strings [ _("On"), _("Off") ] };
                        map => $on_websites_default_javascript_drop_down_map();
                        notify::selected => $on_websites_default_javascript_drop_down_notify_selected();
                      };
                    }

                    StackPage {
                      name: "web-fonts";
                      child: DropDown websitesDefaultWebFontsDropDown {
                        halign:end;
                        model: StringList { strings [ _("On"), _("Off") ] };
                        map => $on_websites_default_web_fonts_drop_down_map();
                        notify::selected => $on_websites_default_web_fonts_drop_down_notify_selected();
                      };
                    }

                    StackPage {
                      name: "ssl-certificate-validation";
                      child: DropDown websitesDefaultSslCertificateValidationDropDown {
                        halign:end;
                        model: StringList { strings [ _("Strict"), _("Ignore") ] };
                        map => $on_websites_default_ssl_certificate_validation_drop_down_map();
                        notify::selected => $on_websites_default_ssl_certificate_validation_drop_down_notify_selected();
                      };
                    }

                    StackPage {
                      name: "user-agent";
                      child: DropDown websitesDefaultUserAgentDropDown {
                        halign:end;
                        model: StringList {
                          strings [
                            _("Automatic"),
                            _("Custom"),
                            _("Chrome"),
                            _("Firefox"),
                            _("Safari"),
                            _("Safari iPhone"),
                            _("Safari iPad"),
                            _("Edge"),
                          ]
                        };
                        map => $on_websites_default_user_agent_drop_down_map();
                        notify::selected => $on_websites_default_user_agent_drop_down_notify_selected();
                      };
                    }

                    StackPage {
                      name: "compatibility-mode";
                      child: DropDown websitesDefaultCompatibilityModeDropDown {
                        halign:end;
                        model: StringList { strings [ _("On"), _("Off") ] };
                        map => $on_websites_default_compatibility_mode_drop_down_map();
                        notify::selected => $on_websites_default_compatibility_mode_drop_down_notify_selected();
                      };
                    }

                    StackPage {
                      name: "external-apps";
                      child: DropDown websitesDefaultExternalAppsDropDown {
                        halign:end;
                        model: StringList { strings [ _("Ask"), _("Don't Allow"), _("Allow") ] };
                        map => $on_websites_default_external_apps_drop_down_map();
                        notify::selected => $on_websites_default_external_apps_drop_down_notify_selected();
                      };
                    }

                    StackPage {
                      name: "picture-in-picture";
                      child: DropDown websitesDefaultPictureInPictureDropDown {
                        halign:end;
                        model: StringList { strings [ _("Automatic"), _("Manual") ] };
                        map => $on_websites_default_picture_in_picture_drop_down_map();
                        notify::selected => $on_websites_default_picture_in_picture_drop_down_notify_selected();
                      };
                    }

                    StackPage {
                      name: "extension-settings";
                      child: Box {};
                    }
                  }
                }

                Separator {
                  layout {
                    row:1;
                    column:0;
                  }
                  margin-bottom:20;
                  orientation:horizontal;
                }

                Box {
                  layout {
                    row:3;
                    column:0;
                  }
                  styles [
                    "frame",
                  ]
                  orientation:vertical;
                  hexpand:true;
                  vexpand:true;
                  margin-start:35;
                  margin-end:35;
                  margin-bottom:15;
                  halign:fill;
                  spacing:5;
                  Label {
                    margin-start:10;
                    margin-top:5;
                    halign:start;
                    label:_("Configured Websites");
                  }
                  Separator {
                    orientation:horizontal;
                    hexpand:true;
                  }
                  ScrolledWindow {
                    hexpand:true;
                    vexpand:true;
                    propagate-natural-width:false;
                    propagate-natural-height:false;
                    ListView configured_websites_list_view {
                      styles [
                        "websites-settings-websites-list",
                      ]
                      hexpand:true;
                      vexpand:true;
                    }
                  }
                }

                Box box85{
                  layout {
                    row:4;
                    column:0;
                  }
                  margin-start:35;
                  margin-end:35;
                  margin-bottom:35;
                  Button add_website_button {
                    icon-name: "plus-large-symbolic";
                    clicked => $on_add_website_clicked();
                  }
                  Button remove_website_button {
                    margin-start: 4;
                    icon-name: "minus-large-symbolic";
                    clicked => $on_remove_website_clicked();
                  }
                }
              }
            };
          }
        };
      }

      // [tab]
      // Label websitesTab{
      //   label: _("Websites");
      // } //End of Websites tab

      StackPage {
        name: "advanced_tab";
        title: _("Advanced");
        child: ScrolledWindow {
          propagate-natural-width: true;
          propagate-natural-height: true;
          Grid { //Advanced tab
            halign:center;
            Grid {
              layout {
                row:0;
                column:0;
              }
              margin-top:20;
              row-spacing:5;
              column-spacing:15;


              Box settingLabelAD1 {
                layout {
                  row:0;
                  column:0;
                }
                margin-bottom:15;
                halign:end;
                Label {
                  label:_("Rendering:");
                }
              }
              Box box86{
                layout {
                  row:0;
                  column:1;
                }
                margin-bottom:15;
                CheckButton enableJSONFormattingCheckButton {
                  sensitive: false; // TODO: implement this
                  label:_("Enable JSON formatting");
                  map => $on_enable_json_formatting_check_button_map();
                  toggled => $on_enable_json_formatting_check_button_toggled();
                }
              }


              Box settingLabelAD2 {
                layout {
                  row:1;
                  column:0;
                }
                valign: start;
                margin-top:4;
                halign:end;
                Label {
                  label:_("Extensions:");
                }
              }
              Box box87{
                layout {
                  row:1;
                  column:1;
                }
                CheckButton allowInstallationChromeExtensionsCheckButton {
                  sensitive: false; // TODO: implement this
                  label:_("Allow installation of 3rd party Chrome extensions");
                  map => $on_allow_installation_of_3rd_party_chrome_extensions_check_button_map();
                  toggled => $on_allow_installation_of_3rd_party_chrome_extensions_check_button_toggled();
                }
              }
              Box box88{
                layout {
                  row:2;
                  column:1;
                }
                margin-bottom:15;
                Grid {
                  CheckButton allowInstallationFireFoxExtensionsCheckButton {
                    sensitive: false; // TODO: implement this
                    layout {
                      row:1;
                      column:0;
                    }
                    label:_("Allow installation of 3rd party Firefox extensions");
                    map => $on_allow_installation_of_3rd_party_firefox_extensions_check_button_map();
                    toggled => $on_allow_installation_of_3rd_party_firefox_extensions_check_button_toggled();
                  }
                  Label {
                    layout {
                      row:2;
                      column:0;
                    }
                    styles [
                      "small-text",
                    ]
                    margin-start:24;
                    use-markup:true;
                    label:_("Read more about <a href=\"https://kagi.com/\">web extensions support</a> in Orion"); //TODO: correct link
                  }
                }
              }


              Box box89{
                layout {
                  row:3;
                  column:1;
                }
                Button manageExtensionsButton {
                  label:_("Manage Extensions…");
                  clicked => $on_manage_extensions_clicked();
                }
              }
            }
          }
        };
      }

      // [tab]
      // Label advancedTab{
      //   label: _("Advanced");
      // } //End of Advanced tab

      StackPage {
        name: "plus_tab";
        title: _("Plus");
        child: ScrolledWindow {
          propagate-natural-width: true;
          propagate-natural-height: true;
          Grid { //Plus tab
            halign:center;
            margin-top:40;
            Grid {
              halign:center;
              layout {
                row:0;
                column:0;
              }
              row-spacing:5;
              Image {
                layout {
                  row: 0;
                  column: 0;
                }
                name: "orion-logo";
                icon-name: "orion-logo";
                pixel-size: 196;
                margin-bottom:15;
                halign:center;
              }
              Label {
                layout {
                  row:1;
                  column:0;
                }
                styles [
                  "gray-text",
                ]
                halign: center;
                label:_("Current plan:");
              }
              Label {
                layout {
                  row:2;
                  column:0;
                }
                styles [
                  "bold-text"
                ]
                halign: center;
                margin-bottom:5;
                label:_("Free");
              }
              Button {
                layout {
                  row:3;
                  column:0;
                }
                styles [
                  "restore-purchases-button",
                ]
                halign: center;
                label:_("Restore Purchase");
                clicked => $on_restore_purchase_clicked();
              }
            }
            Grid {
              halign:center;
              layout {
                row:0;
                column:1;
              }
              row-spacing:20;
              Box {
                layout {
                  row:0;
                  column:0;
                }
                halign:start;
                Label {
                  xalign:0;
                  natural-wrap-mode:inherit;
                  halign:fill;
                  hexpand:true;
                  wrap:true;
                  wrap-mode:word_char;
                  max-width-chars:65;
                  label:_("Since we are self-funded and only generate revenue from our users directly, we currently offer Orion as a subscripion to cover the cost of development.");
                }
              }
              Box box90{
                layout {
                  row:1;
                  column:0;
                }
                halign:start;
                orientation:vertical;
                spacing:10;
                Label {
                  halign:start;
                  margin-bottom:10;
                  label:_("Orion+ gets you the following perks:");
                }
                Box box91{
                  halign:start;
                  Image {
                    icon-name:"star-outline-thick-symbolic";
                    pixel-size:20;
                  }
                  Label {
                    label:_("Special Orion+ App icons");
                    margin-start: 4;
                  }
                }
                Box box92{
                  halign:start;
                  Image {
                    icon-name:"star-outline-thick-symbolic";
                    pixel-size:20;
                  }
                  Label {
                    label:_("Access to Orion Release Candidate and Beta versions");
                    margin-start: 4;
                  }
                }
                Box box93{
                  halign:start;
                  Image {
                    icon-name:"star-outline-thick-symbolic";
                    pixel-size:20;
                  }
                  Label {
                    label:_("Access to Orion iOS TestFlight");
                    margin-start: 4;
                  }
                }
                Box box94{
                  halign:start;
                  Image {
                    icon-name:"star-outline-thick-symbolic";
                    pixel-size:20;
                  }
                  Label {
                    label:_("Orion+ badge on orionfeedback.org");
                    margin-start: 4;
                  }
                }
                Box box95{
                  halign:start;
                  Image {
                    icon-name:"star-outline-thick-symbolic";
                    pixel-size:20;
                  }
                  Label {
                    label:_("Your voice has more weight influencing Orion's product roadmap");
                    margin-start: 4;
                  }
                }
              }
              Button {
                layout {
                  row:2;
                  column:0;
                }
                halign:start;
                label: _("Get Orion+");
                styles ["suggested-action"]
                action-name: "win.get-orion-plus";
              }
            }
          }
        };
      }

      // [tab]
