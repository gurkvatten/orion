using Gtk 4.0;
using Adw 1;

template $FillPasswordDialog: Adw.Dialog {
  name: "fill-password-dialog";
  Box {
    margin-top: 16;
    margin-end: 16;
    margin-bottom: 16;
    margin-start: 16;
    orientation: vertical;
    spacing: 8;

    Box {
      spacing: 24;
      orientation: horizontal;

      Label {
        label: _("Choose a username to fill:");
      }
      Entry search_entry {
        halign: end;
        max-width-chars: 25;
        primary-icon-name: "loupe-large-symbolic";
        placeholder-text: _("Search");
      }
    }

    Box {
      ScrolledWindow {
        hexpand: true;
        vexpand: true;
        hscrollbar-policy: never;
        height-request: 300;

        ColumnView column_view {
          styles ["frame"]
          vexpand: true;
        }
      }
    }

    Box {
      halign: end;
      spacing: 8;

      Button cancel_button {
        label: _("Cancel");
        clicked => $on_cancel_button_clicked();
      }

      Button fill_button {
        label: _("Fill");
        clicked => $on_fill_button_clicked();
        styles ["suggested-action"]
      }
    }
  }
}

SizeGroup {
  mode: horizontal;
  widgets [cancel_button, fill_button]
}