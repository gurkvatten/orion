    }

    [overlay]
    Box overlay_box {
      halign: fill;
      valign: end;
      hexpand: true;
      margin-start: 15;
      margin-end: 15;
      margin-bottom: 15;
      orientation: horizontal;
      Label beta_disclaimer_label {
        styles [
          "pill-label"
        ]
        // Change this disclaimer text when releasing Alpha/Beta versions
        label: _("<span size='12288' weight='bold'>Disclaimer: This software is in active development (beta stage). Expect incomplete features and potential application instability (e.g., coredumps, crashes, or data loss may occur).\nThis is potentially an unstable beta build intended for limited external testing only to gather early feedback.\nSome features, like WebKit Extensions, Data synchronisations are not implemented yet.</span>");
        wrap: true;
        wrap-mode: word_char;
        use-markup: true;
        justify: left;
        visible: false; // Enabled programmatically in Alpha/Beta versions
      }
      Box {
        halign: fill;
        valign: end;
        hexpand: true;
        orientation: horizontal;
      }
      Box {
        halign: end;
        valign: end;
        Button {
          halign: end;
          child: Image {
            icon-name: "sliders-horizontal-symbolic";
            pixel-size: 20;
          };
          clicked => $on_show_preferences_popover_button_clicked();
        }
      }
    }
  }

  GestureClick {
    button: 3;
    released => $on_search_recommendations_secondary_released() swapped;
  }

  PopoverMenu context_menu {
    menu-model: context_menu_model;
  }
}

menu context_menu_model {
  section {
    item {
      label: "Test";
    }
  }
}