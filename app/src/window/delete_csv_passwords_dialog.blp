using Gtk 4.0;
using Adw 1;

template $DeleteCsvPasswordsDialog: Adw.Dialog {
  content-width: 400;
  content-height: 200;
  name: "delete-csv-passwords-dialog";

  Box {
    orientation: vertical;
    spacing: 8;
    margin-top: 16;
    margin-end: 16;
    margin-bottom: 16;
    margin-start: 16;

    Image {
      name: "orion-logo";
      icon-name: "orion-logo";
      pixel-size: 64;
    }

    Label title_label {
      label: _("Orion successfully imported passwords."); // just a proxy, this is set dynamically
      styles ["bold-text"]
      margin-bottom: 8;
      wrap: true;
      xalign: 0.5;
      justify: center;
    }

    Label {
      label: _("To protect your accounts’ security, it is not recommended to have a file containing your passwords on your computer.");
      wrap: true;
      xalign: 0.5;
      justify: center;
    }

    Label {
      label: _("If you delete this file, it will be removed immediately. You can’t undo this action.");
      wrap: true;
      xalign: 0.5;
      justify: center;
    }
  
    Box {
      halign: fill;
      hexpand: true;
      homogeneous: true;
      orientation: vertical;
      spacing: 8;
      margin-top: 8;

      Button {
        label: _("Not Now");
        clicked => $on_not_now_clicked();
        hexpand: true;
      }

      Button delete_file_button {
        label: _("Delete file"); // just a proxy, this is set dynamically
        clicked => $on_delete_file_clicked();
        styles ["destructive-action"]
        hexpand: true;
      }
    }
  }
}
