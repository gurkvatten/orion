using Gtk 4.0;
using Adw 1;

template $RememberPasswordDialog: Adw.Dialog {
  content-width: 320;
  content-height: 250;
  title: _("Remember Password");
  //TODO: set name

  Adw.ToolbarView {
    //[top]
   // Adw.HeaderBar {}

    Box {
      orientation: vertical;
      Box {
        margin-top: 20;
        halign: center;
        Image {
          name: "orion-logo";
          icon-name: "orion-logo";
          pixel-size: 49;
          margin-start: 40;
          margin-end: 40;
        }
      }

      Box {
        orientation: vertical;
        margin-top: 20;
        margin-bottom: 20;
        margin-end: 20;
        margin-start: 20;
        spacing: 10;

        Label perm_label{
          wrap: true;
          max-width-chars: 60;
          width-chars:15;
          justify: center;
          styles [
            "bold-text"
          ]
          label: _("Would you like to save this password?");
        }

        Label change_label{
          wrap: true;
          max-width-chars: 60;
          width-chars:15;
          justify: center;
          label: _("You can view and remove saved passwords in Orion password library.");
        }

        Button allow_once_button {
          label: _("Save Password");
          styles ["suggested-action"]
          margin-top: 10;
          hexpand: true;
          halign: fill;
          clicked => $on_save_password_button_clicked();
        }

        Button never_allow_button {
          label: _("Never for This Website");
          hexpand: true;
          halign: fill;
          clicked => $on_never_allow_button_clicked();
        }

        Button dont_allow_button {
          label: _("Not Now");
          margin-top: 10;
          hexpand: true;
          halign: fill;
          clicked => $on_not_now_button_clicked();
        }
      }
    }
  }
}
SizeGroup {
  mode: horizontal;
  widgets [allow_once_button, never_allow_button, dont_allow_button]
}
