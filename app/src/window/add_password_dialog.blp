using Gtk 4.0;
using Adw 1;

template $AddPasswordDialog: Adw.Dialog {
  content-width: 500;
  content-height: 200;
  name: "add-password-dialog";
  
  Box {
    orientation: vertical;
    spacing: 8;
    margin-top: 16;
    margin-end: 16;
    margin-bottom: 16;
    margin-start: 16;

    Grid {
      hexpand: true;
      column-spacing: 32;
      row-spacing: 8;

      Label {
        layout { row: 0; column: 0; }
        label: _("Website Url:");
        halign: start;
      }
      Entry url_entry {
        layout { row: 0; column: 1; }
        hexpand: true;
        halign: fill;
      }

      Label {
        layout { row: 1; column: 0; }
        label: _("Username:");
        halign: start;
      }
      Entry username_entry {
        layout { row: 1; column: 1; }
        hexpand: true;
        halign: fill;
      }

      Label {
        layout { row: 2; column: 0; }
        label: _("Password:");
        halign: start;
      }
      Entry password_entry {
        layout { row: 2; column: 1; }
        hexpand: true;
        halign: fill;
        visibility: false;
      }
    }

    Box {
      margin-top: 16;
      halign: end;
      hexpand: true;

      Button cancel_button {
        label: _("Cancel");
        clicked => $on_cancel_clicked();
      }
      Button save_password_button {
        label: _("Save Password");
        clicked => $on_save_password_clicked();
        margin-start: 8;
        styles ["suggested-action"]
      }
    }
  }
}

SizeGroup {
  widgets [cancel_button, save_password_button]
}