using Gtk 4.0;

menu show_sidebar_context_menu {
  section {
    item {
      label: _("Tab Groups");
    }
    item {
      label: _("Tabs");
    }
    item {
      label: _("Bookmarks");
    }
    item {
      label: _("Reading List");
    }
  }

  section {
    item {
      label: _("Use Standard Tabs");
    }
    item {
      label: _("Use Compact Tabs");
    }
    item {
      label: _("Use Vertical Tabs");
    }
  }

  section {
    item {
      label: _("Auto-Show Sidebar");
    }
  }
}

menu window_list_button_context_menu {
  section {
    item {
      label: _("Show Icon Only");
      action: "win.window-list-button-style";
      target: "1";
      role: "radio";
    }
    item {
      label: _("Show Name Only");
      action: "win.window-list-button-style";
      target: "2";
      role: "radio";
    }
    item {
      label: _("Show Icon and Name");
      action: "win.window-list-button-style";
      target: "3";
      role: "radio";
    }
  }
}

menu toolbar_context_menu {
  section {
    item {
      label: _("Use Mini Toolbar");
      action: "win.use-mini-toolbar";
    }
  }
  section {
    item {
      label: _("Icon and Text");
      action: "win.toolbar-item-style";
      target: "1";
    }
    item {
      label: _("Icon Only");
      action: "win.toolbar-item-style";
      target: "2";
    }
  }
  section {
    item {
      label: _("Bookmarks Bar");
    }
  }
  section {
    item {
      label: _("Customize Toolbar…");
      action: "win.customize-menu";
    }
  }
  section {
    item {
      label: _("Import Button from URL…");
      action: "win.import-button-from-url";
    }
    item {
      label: _("Import Button from File…");
      action: "win.import-button-from-file";
    }
  }
  section {
    item {
      label: _("Reset Toolbar"); // on Mac: Reset Toolbar (Relaunch to Take Effect)
      action: "win.reset-toolbar";
    }
  }
}

menu reload_button_context_menu {
  section {
    item {
      label: _("Reload Page");
      action: "win.reload-this-page";
    }
  }
  section {
    item {
      label: _("Reload in Compatibility Mode");
      action: "win.reload-this-page-in-compatibility-mode"; // TODO: implement
    }
    item {
      label: _("Reload Without Content Blockers");
      action: "win.reload-this-page-without-content-blockers"; // TODO: implement
    }
  }
}

