using Gtk 4.0;
using Adw 1;

template $ImportCsvPasswordsDialog: Adw.Dialog {
  content-width: 400;
  content-height: 200;
  name: "import-csv-passwords-dialog";

  Box {
    orientation: vertical;
    spacing: 8;
    margin-top: 16;
    margin-end: 16;
    margin-bottom: 16;
    margin-start: 16;

    Image {
      name: "orion-logo";
      icon-name: "orion-logo";
      pixel-size: 64;
    }

    Label title_label {
      label: _("Orion successfully imported passwords."); // just a proxy, this is set dynamically
      styles ["bold-text"]
      margin-bottom: 8;
      wrap: true;
      xalign: 0.5;
      justify: center;
    }

    Expander {
      label: _("Passwords Not Imported");
      expanded: false;
      margin-bottom: 8;

      ScrolledWindow {
        hexpand: true;
        vexpand: true;
        min-content-height: 100;

        ListBox not_imported_passwords_list_box {
          name: "not-imported-passwords-list-box";
          styles ["navigation-sidebar"]
        }
      }
    }
  
    Box {
      halign: fill;
      hexpand: true;
      homogeneous: true;
      orientation: vertical;
      spacing: 8;

      Button open_passwords_button {
        label: _("Open Password Preferences…");
        clicked => $on_open_password_preferences_clicked();
        hexpand: true;
      }

      Button {
        label: _("OK");
        clicked => $on_ok_clicked();
        styles ["suggested-action"]
        hexpand: true;
      }
    }
  }
}
