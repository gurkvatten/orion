using Gtk 4.0;
using Adw 1;

template $EditPasswordDialog: Adw.Dialog {
  content-width: 450;
  content-height: 200;
  title: _("Edit Password");

  Adw.ToolbarView toolbar_view {
     Box {
      orientation: vertical;
      valign: start;
      halign: start;
      margin-start: 24;
      margin-end: 24;
      margin-top: 24;
      margin-bottom: 24;

      Grid {
        hexpand:false;
        row-spacing: 8;
        column-spacing: 16;
        Box {
          layout {
            row:0;
            column:0;
          }
          halign: start;
          Label {
            label:_("Website Url:");
            styles ["bold-text"]
          }
          margin-bottom: 8;
        }
        Box {
          layout {
            row:0;
            column:1;
          }
          halign: start;
          Label url_label {
            label: _("website");
          }
          margin-bottom: 8;      
        }          
        Box {
          layout {
            row:1;
            column:0;
          }
          hexpand:true;
          Label {
            label: _("Username:");
            styles ["bold-text"]
          }
        }
        Box {
          layout {
            row:1;
            column:1;
          }
          hexpand:true;
          Entry username_entry {
            hexpand: true;
            activates-default: false;
            text: "user";
          }
        }
        Box {
          layout {
            row:2;
            column:0;
          }
          orientation: horizontal;
          hexpand: true;
          Label {
            label: _("Password:");
            styles ["bold-text"]
          }
        }
        Box {
          layout {
            row:2;
            column:1;
          }
          orientation: horizontal;
          hexpand:true;
          Entry password_entry {
            hexpand: true;
            activates-default: false;
            text: "password01";
          }
        }
        Box verification_key_box_header {
          layout {
            row:3;
            column:0;
          }
          halign: start;
          Label {
            label:_("Verification Key:");
            styles ["bold-text"]
          }
        }
        Box verification_key_box_content {
          layout {
            row:3;
            column:1;
          }
          halign: start;
          Label verification_key_label {
            label: "abcdef";
          }
          margin-top: 8;
        }
        Box {
          layout {
            row:3;
            column:1;
          }
          hexpand: true;
          Box {
            hexpand: true;
            spacing: 8;
            Entry verification_key_entry { // TODO: disable editing dynamically
              text: "lorem ipsum";
              hexpand: true;
            }
            Button verification_code_setup_button { // TODO: hide dynamically
              label: _("Setup");
              halign: end;
              clicked => $on_setup_clicked();
              sensitive: false;
            }
          }
        }
        Box verification_code_box1 {
          visible: false;
          layout {
            row:4;
            column:0;
          }
          halign: start;
          Label verification_code_header {
            label:_("Verification Code:");
            styles ["bold-text"]
          }
          margin-top: 8;
        }
        Box verification_code_box2 {
          visible: false;
          layout {
            row:4;
            column:1;
          }
          halign: start;
          Label verification_code_label {
            hexpand: true;
          }
          margin-top: 8;
        }
        Box {
          layout {
            row:5;
            column:1;
          }
          orientation: vertical;
          halign: start;
          Label setup_info_label {
            visible: false;
            label: _("If supported, go to website to obtain a setup key and enter it here.");
            wrap: true;
            max-width-chars: 52;
            xalign: 0;
            styles ["dim-label"]
          }
          Label validity_label {
            visible: false;
            // proxy text - generated dynamically
            label: "This code is valid for the next XX seconds.\nA new code will be generated when it expires.";
            wrap: true;
            xalign: 0;
            width-chars: 52;
            styles ["dim-label"]
          }
        }   
        Box delete_box {
          visible: false;
          layout {
            row:6;
            column:1;
          }
          halign: start;
          Button delete_verification_code_button {
            label: _("Delete Verification Code"); 
            clicked => $on_delete_verification_code_clicked();
          }              
        }
        Box {
          layout {
            row:7;
            column:1;
          }
          margin-top: 8;
          halign: end;
          Button cancel_button {
            label: _("Cancel");
            clicked => $on_cancel_clicked();
          }             
          Button save_password_button {
            label: _("Save Password");
            margin-start: 8;           
            styles ["suggested-action"]
            clicked => $on_save_password_clicked();
          }
        }
      }
    }   
  }
}

SizeGroup {
  widgets [cancel_button, save_password_button]
}