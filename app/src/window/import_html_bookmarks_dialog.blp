using Gtk 4.0;
using Adw 1;

template $ImportHtmlBookmarksDialog: Adw.Dialog {
  content-width: 400;
  content-height: 150;
  name: "import-html-bookmarks-dialog";
  can-close: false; // prevent closing the dialog while importing

  Box {
    orientation: vertical;
    spacing: 8;
    margin-top: 16;
    margin-end: 16;
    margin-bottom: 16;
    margin-start: 16;

    Label status_label {
      label: _("Importing…");
      halign: start;
      hexpand: true;
    }
    Label result_label {
      halign: start;
      hexpand: true;
    }
    Button close_button {
      label: _("Close");
      hexpand: false;
      halign: end;
      vexpand: true;
      valign: end;
      clicked => $on_close_clicked();
      sensitive: false; // will be set to true when the result is ready
    }
  }
}
