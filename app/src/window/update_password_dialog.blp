using Gtk 4.0;
using Adw 1;

template $UpdatePasswordDialog: Adw.Dialog {
  content-width: 320;
  content-height: 250;
  title: _("Update Password");

  Adw.ToolbarView {
    //[top]
   // Adw.HeaderBar {}

    Box {
      orientation: vertical;
      Box {
        margin-top: 20;
        halign: center;
        Image {
          name: "orion-logo";
          icon-name: "orion-logo";
          pixel-size: 49;
          margin-start: 40;
          margin-end: 40;
        }
      }

      Box {
        orientation: vertical;
        margin-top: 20;
        margin-bottom: 20;
        margin-end: 20;
        margin-start: 20;
        spacing: 10;

        Label perm_label{
          wrap: true;
          max-width-chars: 60;
          width-chars:15;
          justify: center;
          styles [
            "bold-text"
          ]
          label: _("Would you like to update the password for this website?");
        }

        Label change_label{
          wrap: true;
          max-width-chars: 60;
          width-chars:15;
          justify: center;
          label: _("You can view and remove saved passwords in Orion password library.");
        }

        Button update_button {
          label: _("Update Password");
          styles ["suggested-action"]
          margin-top: 10;
          hexpand: true;
          halign: fill;
          clicked => $on_update_password_button_clicked();
        }

        Button do_not_update_button {
          label: _("Do Not Update");
          margin-top: 10;
          hexpand: true;
          halign: fill;
          clicked => $on_do_not_update_button_clicked();
        }
      }
    }
  }
}
SizeGroup {
  mode: horizontal;
  widgets [update_button, do_not_update_button]
}
