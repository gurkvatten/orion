using Gtk 4.0;
using Adw 1;

template $DeleteVerificationCodeDialog: Adw.Dialog {
  content-width: 200;
  content-height: 200;
  title: _("Delete Verification Code");
  name: "delete-verification-code-dialog";

  Adw.ToolbarView {
    
    Box {
      orientation: vertical;
      valign: start;
      margin-top: 16;
      margin-end: 16;
      margin-bottom: 16;
      margin-start: 16;
      spacing: 16;
        
      Box {
        halign: center;
        Image {
          name: "orion-logo"; 
          icon-name: "orion-logo";
          pixel-size: 64;
        }
      }
       Box {
         halign: center;
        Label {
          styles ["bold-text"]
          label: _("Are you sure you want to delete the verification code?");
          wrap: true;
          max-width-chars: 35;
          justify: center;
        }
      }
                 
      Box {
        hexpand: true;
        halign: fill;
        orientation: vertical;
        Button delete_button {
          label: _("Delete Verification Code"); 
          hexpand: true;
          halign: fill;
          styles ["destructive-action"]
          clicked => $on_delete_clicked();
        }             
        Button cancel_button {
          label: _("Cancel"); 
          margin-top: 8;
          hexpand: true;
          halign: fill;
          clicked => $on_cancel_clicked();
        }
      }
    }
  }
}


