using Gtk 4.0;
using Adw 1;



template $JsSidebar: Box {
  name: "sidebar";
  orientation: vertical;
  hexpand: true;
  margin-start: 6;
  margin-top: 6;
  margin-end: 6;
  margin-bottom: 6;


  Adw.ToolbarView {
    [top]
    CenterBox {
      margin-bottom: 8;
      [center]
      Label title_label {
        //this will be set programatically to the title of the programmable button last triggering an action
        label: _("Programmable Button");
      }

      [end]
      Button {
        icon-name: "window-close-symbolic";

        clicked => $on_close_clicked();
        accessibility {
          label: _("Close programmable button output sidebar");
        }
      }
    }

    content: ScrolledWindow {
      TextView text_view {
        editable: false;
        hexpand:true;
        vexpand:true;
      }
    };
  }
}
