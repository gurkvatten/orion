using Gtk 4.0;

menu window_tabs_row_context_menu {
  section {
    item {
      label: _("Save…");
      action: "win.edit-current-window-group";
    }
  }

  section {
    item {
      label: _("Duplicate");
    }
    item {
      label: _("Close Window");
    }
  }

  section {
    submenu {
      label: _("3 Tabs"); // TODO: this should be the number of tabs in the window

      section {
        item {
          label: _("Copy Tab Links");
        }
        item {
          label: _("Bookmark 3 Tabs"); // TODO: this should be the number of tabs in the window
        }
        item {
          label: _("Suspend 3 Tabs"); // TODO: this should be the number of tabs in the window
        }
      }

      section {
        // TODO: fill this dynamically with the tabs in the window
      }
    }
  }
}

// not used
menu window_row_context_menu {
  section {
    item {
      label: _("Open in Separate Window"); // TODO: hide this dynamically
    }
  }

  section {
    item {
