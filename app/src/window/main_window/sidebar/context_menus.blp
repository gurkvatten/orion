menu bookmarks_bar_list_view_context_menu {
  section {
    item {
      label: _("Add Bookmark…");
      action: "win.bookmarks-add-bookmark";
    }
    item {
      label: _("New Folder");
      action: "win.bookmarks-add-folder";
    }
  }

  section {
    item {
      label: _("Text Only");
      action: "win.bookmarks-bar-style";
      target: "1";
    }
    item {
      label: _("Icon and Text");
      action: "win.bookmarks-bar-style";
      target: "2";
    }
    item {
      label: _("Icon Only");
      action: "win.bookmarks-bar-style";
      target: "3";
    }
  }
  
  section {
    item {
      label: _("Hide Bookmarks Bar");
      action: "win.hide-bookmarks-bar";
    }
  }
}

