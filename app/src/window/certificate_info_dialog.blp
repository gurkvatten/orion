using Gtk 4.0;
using Adw 1;

template $CertificateInfoDialog: Adw.Dialog {
  content-width: 600;
  content-height: 600;

  Box {
    orientation: vertical;
    margin-top: 16;
    margin-end: 16;
    margin-bottom: 16;
    margin-start: 16;

    Label title_label {
      label: _("Certificate Information");
      halign: start;
      styles ["title-3"]
    }

    ListBox certificate_list {
      styles ["frame"]
      selection-mode: single;
      margin-top: 12;
      row-selected => $on_certificate_list_row_selected();
    }

    ScrolledWindow {
      styles ["frame"]
      margin-top: 8;
      vexpand: true;
      hscrollbar-policy: never;

      Box details_box {
        orientation: vertical;
        margin-top: 12;
        margin-end: 12;
        margin-bottom: 12;
        margin-start: 12;
      }
    }

    Box {
      Button ok_button {
        label: _("OK");
        halign: end;
        hexpand: true;
        styles ["suggested-action"]
        margin-top: 8;
        clicked => $on_ok_button_clicked();
      }
    }
  }
}
